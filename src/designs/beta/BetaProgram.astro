---
import { schedule } from '../../content/schedule';

const kindLabel = {
	session: 'Talk',
	break: 'Break',
	logistics: 'Ops',
	community: 'Community',
} as const;
---

<section class="beta-band" id="program" aria-labelledby="program-mark" tabindex="-1">
	<div class="beta-wrap">
		<p class="beta-mark beta-reveal" id="program-mark" data-text="Program">Program</p>
		<header class="beta-program-head beta-reveal">
			<h2>One day. One room. Full schedule.</h2>
		</header>

		<ol class="chain" aria-label="Conference schedule">
			{
				schedule.map((item, index) => (
					<li
						class:list={['chain__block', 'beta-reveal', `chain__block--${item.kind}`]}
						style={`--d: ${Math.min(index, 6) * 50}ms`}
					>
						<span class="chain__node" aria-hidden="true" />
						<div class="chain__card beta-glass" data-spotlight>
							<div class="chain__meta">
								<span class="chain__height">#{String(index + 1).padStart(4, '0')}</span>
								<time class="chain__time">{item.timeLabel}</time>
							</div>
							<div class="chain__body">
								<h3>{item.title}</h3>
								{item.detail && <p>{item.detail}</p>}
							</div>
							<div class="chain__tags">
								<span class="chain__kind">{kindLabel[item.kind]}</span>
							</div>
						</div>
					</li>
				))
			}
		</ol>
	</div>
</section>

<style>
	.beta-program-head {
		margin-bottom: clamp(2rem, 4vw, 3rem);
	}

	.beta-program-head h2 {
		max-width: none;
		margin: 0;
		font-size: clamp(1.7rem, 3.6vw, 3.15rem);
		white-space: nowrap;
		letter-spacing: -0.04em;
	}

	.chain {
		position: relative;
		list-style: none;
		margin: 0;
		padding: 0 0 0 2.25rem;
		display: grid;
		gap: 0.75rem;
	}

	.chain::before {
		content: '';
		position: absolute;
		top: 0.5rem;
		bottom: 0.5rem;
		left: 0.6rem;
		width: 1px;
		background: linear-gradient(180deg, transparent, var(--beta-line) 6%, var(--beta-line) 94%, transparent);
	}

	.chain::after {
		content: '';
		position: absolute;
		top: 0;
		left: calc(0.6rem - 1px);
		width: 3px;
		height: 18%;
		border-radius: 3px;
		background: linear-gradient(180deg, transparent, var(--beta-accent-bright), #a6fff0, transparent);
		filter: drop-shadow(0 0 8px var(--beta-accent-bright));
		opacity: 0;
	}

	.chain__block {
		position: relative;
	}

	.chain__node {
		position: absolute;
		top: 50%;
		left: -2.25rem;
		width: 1.2rem;
		height: 1.2rem;
		transform: translateY(-50%) rotate(45deg);
		border-radius: 4px;
		border: 1px solid var(--beta-line);
		background: var(--beta-bg);
		transition:
			border-color 240ms var(--beta-ease),
			box-shadow 240ms var(--beta-ease);
	}

	.chain__node::after {
		content: '';
		position: absolute;
		inset: 0.3rem;
		border-radius: 1px;
		background: var(--beta-accent-bright);
		opacity: 0.6;
	}

	.chain__block:hover .chain__node {
		border-color: var(--beta-accent-bright);
		box-shadow: 0 0 16px rgba(91, 136, 255, 0.7);
	}

	.chain__card {
		display: grid;
		grid-template-columns: 7.5rem minmax(0, 1fr) auto;
		align-items: center;
		gap: 1.5rem;
		padding: 1.15rem 1.4rem;
		border-radius: var(--beta-radius);
		transition: transform 300ms var(--beta-spring);
	}

	.chain__block:hover .chain__card {
		transform: translateX(4px);
	}

	.chain__meta {
		display: grid;
		gap: 0.2rem;
		font-family: var(--beta-mono);
		font-variant-numeric: tabular-nums;
	}

	.chain__height {
		font-size: 0.72rem;
		color: var(--beta-text-faint);
	}

	.chain__time {
		font-size: 0.95rem;
		color: var(--beta-accent-bright);
	}

	.chain__body h3 {
		margin: 0 0 0.2rem;
		font-size: 1.05rem;
	}

	.chain__body p {
		margin: 0;
		font-size: 0.92rem;
		color: var(--beta-text-dim);
	}

	.chain__tags {
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		gap: 0.35rem;
		font-family: var(--beta-mono);
		font-size: 0.72rem;
	}

	.chain__kind {
		padding: 0.25rem 0.6rem;
		border: 1px solid var(--beta-line);
		border-radius: 999px;
		color: var(--beta-ice);
	}

	.chain__block--session .chain__kind {
		border-color: rgba(91, 136, 255, 0.45);
		background: rgba(30, 86, 240, 0.14);
	}

	.chain__block--community .chain__kind {
		border-color: rgba(124, 245, 212, 0.35);
		background: rgba(124, 245, 212, 0.06);
		color: #b9fbe9;
	}

	.chain__block--break .chain__card {
		background: transparent;
		border-style: dashed;
		box-shadow: none;
		backdrop-filter: none;
		-webkit-backdrop-filter: none;
	}

	.chain__block--break .chain__node::after {
		opacity: 0;
	}

	@media (prefers-reduced-motion: no-preference) {
		.chain::after {
			opacity: 1;
			animation: chain-flow 5.5s linear infinite;
		}
	}

	@keyframes chain-flow {
		from {
			top: 0;
		}
		to {
			top: 82%;
		}
	}

	@media (max-width: 720px) {
		.chain {
			padding-left: 1.75rem;
		}

		.chain__node {
			left: -1.75rem;
			width: 1rem;
			height: 1rem;
		}

		.chain::before,
		.chain::after {
			left: 0.45rem;
		}

		.chain__card {
			grid-template-columns: 1fr;
			gap: 0.75rem;
		}

		.chain__meta {
			grid-auto-flow: column;
			justify-content: space-between;
		}

		.chain__tags {
			flex-direction: row;
			justify-content: space-between;
			align-items: center;
		}
	}
</style>
