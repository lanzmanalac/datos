---
import { about } from '../../content/about';
import { event } from '../../content/event';
import { socials } from '../../content/socials';

const stats = [
	{ value: '4–9 PM', label: 'Time' },
	{ value: '60–80', label: 'Seats' },
	{ value: 'Nov 20', label: 'Date' },
	{ value: 'Google Philippines', label: 'Venue', long: true },
];
---

<section class="beta-band" id="about" aria-labelledby="about-mark" tabindex="-1">
	<div class="beta-wrap">
		<p class="beta-mark beta-reveal" id="about-mark" data-text="About">About</p>
		<div class="about-bento">
			<article class="beta-glass about-tile about-tile--theme beta-reveal" data-spotlight>
				<h2>{event.theme}</h2>
				<p class="beta-lede">{about.datos.body}</p>
				<div class="about-tile__rings" aria-hidden="true">
					<span></span><span></span><span></span>
				</div>
			</article>

			<article class="beta-glass about-tile about-tile--stats beta-reveal" style="--d: 80ms" data-spotlight>
				<dl class="about-stats">
					{
						stats.map((stat) => (
							<div class:list={['about-stat', stat.long && 'about-stat--long']}>
								<dt>{stat.label}</dt>
								<dd>{stat.value}</dd>
							</div>
						))
					}
				</dl>
			</article>

			<article class="beta-glass about-tile about-tile--dep beta-reveal" style="--d: 140ms" data-spotlight>
				<p class="about-tile__kicker">{event.organizer}</p>
				<h3>{about.dep.title}</h3>
				<p>{about.dep.body}</p>
			</article>

			<article class="beta-glass about-tile about-tile--community beta-reveal" style="--d: 200ms" data-spotlight>
				<div>
					<h3>{about.community.title}</h3>
					<p>{about.community.body}</p>
				</div>
				<ul class="about-socials" aria-label="Community links">
					{
						socials.map((item) => (
							<li>
								<a class="about-social" href={item.href} rel="noopener noreferrer" target="_blank" aria-label={item.label}>
									{item.id === 'website' && (
										<svg viewBox="0 0 24 24" aria-hidden="true">
											<path
												fill="currentColor"
												d="M12 2.5 4.8 7.1v9.8L12 21.5l7.2-4.6V7.1L12 2.5Zm0 2.3 5.1 3.2v1.4l-5.1 3.1-5.1-3.1V8L12 4.8Zm-5.1 6.1 4.3 2.6v5.1l-4.3-2.8v-4.9Zm6 7.7v-5.1l4.3-2.6v4.9l-4.3 2.8Z"
											/>
										</svg>
									)}
									{item.id === 'meetup' && (
										<svg viewBox="0 0 24 24" aria-hidden="true">
											<path
												fill="currentColor"
												d="M6.9 7.4c.9 0 1.6.7 1.6 1.6S7.8 10.6 6.9 10.6 5.3 9.9 5.3 9 6 7.4 6.9 7.4Zm4.7-.7c1.1 0 2 .9 2 2s-.9 2-2 2-2-.9-2-2 .9-2 2-2Zm5.1.4c1 0 1.8.8 1.8 1.8s-.8 1.8-1.8 1.8-1.8-.8-1.8-1.8.8-1.8 1.8-1.8ZM5.2 12.2c1.2 0 2.2 1 2.2 2.2s-1 2.2-2.2 2.2-2.2-1-2.2-2.2 1-2.2 2.2-2.2Zm4.8-.3c1.4 0 2.5 1.1 2.5 2.5S11.4 16.9 10 16.9s-2.5-1.1-2.5-2.5 1.1-2.5 2.5-2.5Zm5.3.5c1.3 0 2.3 1 2.3 2.3s-1 2.3-2.3 2.3-2.3-1-2.3-2.3 1-2.3 2.3-2.3Zm4.5 1c.9 0 1.6.7 1.6 1.6s-.7 1.6-1.6 1.6-1.6-.7-1.6-1.6.7-1.6 1.6-1.6Z"
											/>
										</svg>
									)}
									{item.id === 'facebook' && (
										<svg viewBox="0 0 24 24" aria-hidden="true">
											<path
												fill="currentColor"
												d="M14.5 8.5h2.2V5.2H14.3c-2.4 0-4 1.5-4 4v1.7H8.2v3.3h2.1V21h3.5v-6.8h2.4l.5-3.3h-2.9V9.8c0-.8.3-1.3 1.2-1.3Z"
											/>
										</svg>
									)}
									{item.id === 'linkedin' && (
										<svg viewBox="0 0 24 24" aria-hidden="true">
											<path
												fill="currentColor"
												d="M7.4 9.3H4.5V19h2.9V9.3ZM5.9 5c-.9 0-1.7.7-1.7 1.6S5 8.3 5.9 8.3s1.7-.7 1.7-1.6S6.9 5 5.9 5ZM19.5 13.2c0-2.5-1.3-4.1-3.7-4.1-1.3 0-2.2.7-2.6 1.4h-.1V9.3h-2.8c0 .7 0 9.7 0 9.7h2.9v-5.4c0-.3 0-.6.1-.8.3-.6.9-1.3 1.9-1.3 1.3 0 1.9 1 1.9 2.5V19h2.9v-5.8Z"
											/>
										</svg>
									)}
								</a>
							</li>
						))
					}
				</ul>
			</article>
		</div>
	</div>
</section>

<style>
	.about-bento {
		display: grid;
		grid-template-columns: repeat(12, minmax(0, 1fr));
		gap: 1rem;
	}

	.about-tile {
		padding: clamp(1.5rem, 3vw, 2.25rem);
		overflow: hidden;
	}

	.about-tile--theme {
		grid-column: span 7;
		min-height: 24rem;
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		border-radius: var(--beta-radius-lg);
	}

	.about-tile--theme h2 {
		max-width: 18ch;
		margin-bottom: 1.25rem;
	}

	.about-tile--theme .beta-lede {
		margin: 0;
	}

	.about-tile__rings {
		position: absolute;
		top: -6rem;
		right: -6rem;
		width: 22rem;
		aspect-ratio: 1;
		pointer-events: none;
		z-index: -1;
	}

	.about-tile__rings span {
		position: absolute;
		inset: 0;
		border-radius: 50%;
		border: 1px solid rgba(143, 179, 255, 0.14);
	}

	.about-tile__rings span:nth-child(2) {
		inset: 3.5rem;
		border-color: rgba(143, 179, 255, 0.2);
	}

	.about-tile__rings span:nth-child(3) {
		inset: 7rem;
		border: none;
		background: radial-gradient(circle, rgba(30, 86, 240, 0.5), transparent 70%);
		filter: blur(10px);
	}

	.about-tile--stats {
		grid-column: span 5;
		padding: 0;
		overflow: visible;
		border-radius: var(--beta-radius-lg);
	}

	.about-stats {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		height: 100%;
		margin: 0;
	}

	.about-stat {
		display: flex;
		flex-direction: column-reverse;
		justify-content: flex-end;
		gap: 0.6rem;
		padding: clamp(1.25rem, 2.5vw, 1.75rem);
		border-color: var(--beta-line-faint);
		border-style: solid;
		border-width: 0;
	}

	.about-stat:nth-child(odd) {
		border-right-width: 1px;
	}

	.about-stat:nth-child(-n + 2) {
		border-bottom-width: 1px;
	}

	.about-stat dt {
		font-size: 0.86rem;
		color: var(--beta-text-dim);
	}

	.about-stat dd {
		margin: 0;
		font-family: var(--beta-display);
		font-weight: 600;
		font-size: clamp(1.65rem, 2.6vw, 2.35rem);
		line-height: 1.05;
		letter-spacing: -0.04em;
		text-wrap: balance;
		font-variant-numeric: tabular-nums;
		background: var(--beta-chrome);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
	}

	.about-stat--long dd {
		font-size: clamp(1.15rem, 1.7vw, 1.55rem);
		letter-spacing: -0.03em;
		line-height: 1.15;
	}

	.about-tile--dep {
		grid-column: span 8;
		padding-block: 1.35rem;
	}

	.about-tile__kicker {
		margin: 0 0 0.75rem;
		font-family: var(--beta-display);
		font-weight: 600;
		font-size: clamp(1.35rem, 2.1vw, 1.85rem);
		line-height: 1.12;
		letter-spacing: -0.03em;
		color: var(--beta-text);
		text-wrap: balance;
	}

	.about-tile--community {
		grid-column: span 4;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: 1rem;
		padding-block: 1.35rem;
		background:
			radial-gradient(120% 140% at 100% 100%, rgba(30, 86, 240, 0.28), transparent 55%),
			linear-gradient(180deg, rgba(255, 255, 255, 0.05), rgba(255, 255, 255, 0.012) 60%),
			rgba(8, 11, 24, 0.55);
	}

	.about-tile--dep p,
	.about-tile--community p {
		margin: 0;
	}

	.about-socials {
		display: flex;
		flex-wrap: wrap;
		gap: 0.55rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.about-social {
		display: grid;
		place-items: center;
		width: 2.55rem;
		height: 2.55rem;
		border: 1px solid var(--beta-line);
		border-radius: 14px;
		background: rgba(255, 255, 255, 0.04);
		color: var(--beta-text);
		transition:
			border-color 200ms var(--beta-ease),
			background-color 200ms var(--beta-ease),
			transform 180ms var(--beta-spring),
			color 200ms var(--beta-ease);
	}

	.about-social svg {
		width: 1.15rem;
		height: 1.15rem;
	}

	.about-social:hover {
		border-color: rgba(170, 196, 255, 0.45);
		background: rgba(143, 179, 255, 0.1);
		color: var(--beta-accent-bright);
		transform: translateY(-1px);
	}

	.about-social:active {
		transform: scale(0.97);
	}

	@media (max-width: 900px) {
		.about-tile--theme,
		.about-tile--stats,
		.about-tile--dep,
		.about-tile--community {
			grid-column: 1 / -1;
		}

		.about-tile--theme {
			min-height: 20rem;
		}
	}
</style>
