<canvas class="beta-graph" data-beta-graph aria-hidden="true"></canvas>

<style is:global>
	.beta-graph {
		position: absolute;
		inset: 0;
		z-index: 2;
		width: 100%;
		height: 100%;
		pointer-events: none;
		opacity: 1;
	}

	.beta.alpha .beta-graph {
		opacity: 1;
	}
</style>

<script>
	type GraphNode = { x: number; y: number; vx: number; vy: number; r: number };
	type Packet = { a: number; b: number; t: number; speed: number };

	const canvas = document.querySelector<HTMLCanvasElement>('[data-beta-graph]');
	const ctx = canvas?.getContext('2d');

	if (canvas && ctx) {
		const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		const light = document.body.classList.contains('alpha');
		const LINK = light ? 168 : 150;
		const POINTER = 200;
		const palette = light
			? {
					line: (a: number) => `rgba(30, 86, 240, ${a})`,
					pointer: (a: number) => `rgba(14, 116, 144, ${a})`,
					nodeBig: 'rgba(30, 86, 240, 0.88)',
					nodeSmall: 'rgba(59, 110, 230, 0.72)',
					packetCore: 'rgba(30, 86, 240, 0.95)',
					packetEdge: 'rgba(30, 86, 240, 0)',
					lineMax: 0.42,
					pointerMax: 0.4,
				}
			: {
					line: (a: number) => `rgba(110, 150, 255, ${a})`,
					pointer: (a: number) => `rgba(166, 255, 240, ${a})`,
					nodeBig: 'rgba(201, 216, 255, 0.95)',
					nodeSmall: 'rgba(110, 150, 255, 0.72)',
					packetCore: 'rgba(201, 230, 255, 0.95)',
					packetEdge: 'rgba(91, 136, 255, 0)',
					lineMax: 0.24,
					pointerMax: 0.35,
				};

		let w = 0;
		let h = 0;
		let nodes: GraphNode[] = [];
		let packets: Packet[] = [];
		let running = false;
		let raf = 0;
		let lastSpawn = 0;
		const pointer = { x: -9999, y: -9999 };

		const resize = () => {
			const dpr = Math.min(window.devicePixelRatio || 1, 2);
			w = window.innerWidth;
			h = window.innerHeight;
			canvas.width = Math.round(w * dpr);
			canvas.height = Math.round(h * dpr);
			ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
			const density = light ? 11000 : 14000;
			const count = Math.round(Math.min(130, Math.max(40, (w * h) / density)));
			nodes = Array.from({ length: count }, () => ({
				x: Math.random() * w,
				y: Math.random() * h,
				vx: (Math.random() - 0.5) * 0.2,
				vy: (Math.random() - 0.5) * 0.2,
				r: Math.random() < 0.16 ? 2.3 : 1.25,
			}));
			packets = [];
		};

		const linked = (a: GraphNode, b: GraphNode) => Math.hypot(a.x - b.x, a.y - b.y) < LINK;

		const draw = (time: number) => {
			ctx.clearRect(0, 0, w, h);

			for (const n of nodes) {
				if (!reduce) {
					const dx = pointer.x - n.x;
					const dy = pointer.y - n.y;
					const d = Math.hypot(dx, dy);
					if (d < POINTER && d > 1) {
						n.vx += (dx / d) * 0.0035;
						n.vy += (dy / d) * 0.0035;
					}
					n.vx *= 0.995;
					n.vy *= 0.995;
					n.x += n.vx;
					n.y += n.vy;
					if (n.x < 0 || n.x > w) n.vx *= -1;
					if (n.y < 0 || n.y > h) n.vy *= -1;
				}
			}

			ctx.lineWidth = light ? 1.15 : 1;
			for (let i = 0; i < nodes.length; i++) {
				for (let j = i + 1; j < nodes.length; j++) {
					const a = nodes[i];
					const b = nodes[j];
					const d = Math.hypot(a.x - b.x, a.y - b.y);
					if (d >= LINK) continue;
					ctx.strokeStyle = palette.line((1 - d / LINK) * palette.lineMax);
					ctx.beginPath();
					ctx.moveTo(a.x, a.y);
					ctx.lineTo(b.x, b.y);
					ctx.stroke();
				}
				const n = nodes[i];
				const dp = Math.hypot(pointer.x - n.x, pointer.y - n.y);
				if (dp < POINTER) {
					ctx.strokeStyle = palette.pointer((1 - dp / POINTER) * palette.pointerMax);
					ctx.beginPath();
					ctx.moveTo(n.x, n.y);
					ctx.lineTo(pointer.x, pointer.y);
					ctx.stroke();
				}
			}

			for (const n of nodes) {
				ctx.fillStyle = n.r > 2 ? palette.nodeBig : palette.nodeSmall;
				ctx.beginPath();
				ctx.arc(n.x, n.y, n.r, 0, Math.PI * 2);
				ctx.fill();
			}

			if (!reduce) {
				if (time - lastSpawn > 260 && packets.length < 18) {
					const a = Math.floor(Math.random() * nodes.length);
					const b = nodes.findIndex((n, i) => i !== a && linked(nodes[a], n));
					if (b !== -1) packets.push({ a, b, t: 0, speed: 0.008 + Math.random() * 0.01 });
					lastSpawn = time;
				}
				packets = packets.filter((p) => {
					p.t += p.speed;
					const a = nodes[p.a];
					const b = nodes[p.b];
					if (p.t >= 1 || !a || !b || !linked(a, b)) return false;
					const x = a.x + (b.x - a.x) * p.t;
					const y = a.y + (b.y - a.y) * p.t;
					const glow = ctx.createRadialGradient(x, y, 0, x, y, 8);
					glow.addColorStop(0, palette.packetCore);
					glow.addColorStop(1, palette.packetEdge);
					ctx.fillStyle = glow;
					ctx.beginPath();
					ctx.arc(x, y, 8, 0, Math.PI * 2);
					ctx.fill();
					return true;
				});
			}
		};

		const loop = (time: number) => {
			draw(time);
			if (running) raf = requestAnimationFrame(loop);
		};

		const start = () => {
			if (running || reduce) return;
			running = true;
			raf = requestAnimationFrame(loop);
		};

		const stop = () => {
			running = false;
			cancelAnimationFrame(raf);
		};

		resize();
		draw(0);
		if (!reduce) start();

		let resizeTimer = 0;
		window.addEventListener('resize', () => {
			window.clearTimeout(resizeTimer);
			resizeTimer = window.setTimeout(() => {
				resize();
				draw(0);
			}, 150);
		});

		window.addEventListener(
			'pointermove',
			(event) => {
				pointer.x = event.clientX;
				pointer.y = event.clientY;
			},
			{ passive: true },
		);
		window.addEventListener('pointerleave', () => {
			pointer.x = -9999;
			pointer.y = -9999;
		});

		document.addEventListener('visibilitychange', () => {
			if (document.hidden) stop();
			else if (!reduce) start();
		});
	}
</script>
